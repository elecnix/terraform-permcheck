{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogGroupsByPrefix",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:111111111111:log-group:/ecs/example*",
        "arn:aws:logs:us-east-1:111111111111:log-group:/aws/lambda/example-*"
      ]
    }
  ]
}
